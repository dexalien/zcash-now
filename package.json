{
  "name": "zcash-now",
  "version": "0.1.0",
  "description": "Zcash docs that cannot lie: every recipe is re-run against NU7 testnet and stamped with the txid it produced.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "zcash-now": "dist/index.js"
  },
  "files": [
    "dist",
    "proto",
    "llms.txt"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "start": "node dist/index.js",
    "recipes": "node dist/runner.js",
    "demo": "npx --yes serve demo -l 5173",
    "test": "node test/f4jumble.test.mjs && node test/address.test.mjs",
    "site": "node scripts/build-site.mjs",
    "spend": "ZCASH_NOW_SPEND=1 node dist/runner.js"
  },
  "dependencies": {
    "@grpc/grpc-js": "1.14.7",
    "@grpc/proto-loader": "0.8.1",
    "@modelcontextprotocol/sdk": "1.32.2",
    "bech32": "2.0.0",
    "blake2b": "2.1.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "5.9.3"
  }
}
